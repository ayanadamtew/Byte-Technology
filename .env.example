# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, canonical URLs, and sitemap generation.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Server-side API key for Resend email delivery on POST /api/contact.
# Keep this secret on the server only; never expose in VITE_ variables.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Verified sender identity in Resend (defaults to Byte Technology <onboarding@resend.dev>).
RESEND_FROM_EMAIL="Byte Technology Consultation <onboarding@resend.dev>"

# CONTACT_RECIPIENT_EMAIL: Target email for Byte Technology consultation notifications.
CONTACT_RECIPIENT_EMAIL="ayanadamtew@gmail.com"

# Optional Verified Social Profile Links (rendered in Footer only when valid https:// URLs are provided):
VITE_SOCIAL_LINKEDIN_URL=""
VITE_SOCIAL_GITHUB_URL=""
VITE_SOCIAL_FACEBOOK_URL=""

